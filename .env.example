# ============================================================================
# Variables de entorno que necesitan las funciones de /api.
# Este archivo es sólo un modelo: NO lleva valores reales y SÍ se sube a
# GitHub. Los valores de verdad se cargan en Vercel → tu proyecto →
# Settings → Environment Variables (nunca en un archivo del repositorio).
# ============================================================================

# Access Token de Mercado Pago (de prueba mientras probás, real cuando
# publiques). Se consigue en mercadopago.com.ar/developers/panel.
MP_ACCESS_TOKEN=

# URL pública del sitio ya publicado, sin la barra final.
# Ejemplo: https://piedralibrelosmolles.com.ar  o  https://tu-proyecto.vercel.app
SITE_URL=

# Cuenta de Gmail que manda los mails de pedido (piedralibremerlo@gmail.com).
GMAIL_USER=

# "Contraseña de aplicación" de esa cuenta de Gmail (NO es la contraseña
# normal): se genera en https://myaccount.google.com/apppasswords, hace
# falta tener activada la verificación en dos pasos primero.
GMAIL_APP_PASSWORD=
